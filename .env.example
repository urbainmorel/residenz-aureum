# Copier ce fichier vers .env.local, qui reste ignoré par Git.
# URL canonique publique. Utiliser un domaine .invalid en local.
PUBLIC_SITE_URL=https://preview.residenz-aureum.invalid
CONTACT_RUNTIME_MODE=preview
CONTACT_TRANSPORT_MODE=disabled

# Origines autorisées, séparées par des virgules.
CONTACT_ALLOWED_ORIGINS=https://preview.residenz-aureum.invalid,http://localhost:5173

# Valeurs factices : ne jamais utiliser ces exemples dans un environnement réel.
RESEND_API_KEY=re_example_only_do_not_use
RESEND_FROM_EMAIL="Residenz Aureum <kontakt@example.invalid>"
RESEND_CONTACT_TO=contact@example.invalid
CONTACT_RATE_LIMIT_SECRET=replace-with-a-random-server-side-secret
CONTACT_FALLBACK_PHONE=+490000000

# Assertions de recette obligatoires avant le build de production.
RESEND_DOMAIN_VERIFIED=false
RESEND_SPF_VERIFIED=false
RESEND_DKIM_VERIFIED=false
RESEND_DOMAIN_APPROVAL_REF=https://approval.example.invalid/resend-domain

# Optionnel, réservé aux futurs webhooks Resend.
RESEND_WEBHOOK_SECRET=whsec_example_only_do_not_use
